# Standalone AIS Studio runtime
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Supabase project used by dashboard, assets, auth, and project_state APIs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Main generation key used by Gemini / Veo routes.
GOOGLE_AI_API_KEY=

# Optional model overrides.
GOOGLE_TEXT_MODEL=
GOOGLE_IMAGE_MODEL=
GOOGLE_VIDEO_MODEL=
GOOGLE_TRANSCRIPT_MODEL=
GOOGLE_KB_MODEL=
GOOGLE_BRAIN_DUMP_MODEL=
GOOGLE_STYLE_BIBLE_MODEL=
GOOGLE_SCRIPT_FILE_MODEL=
GOOGLE_CHARACTER_IMAGE_MODEL=
GOOGLE_LOCATION_IMAGE_MODEL=
GOOGLE_QUALITY_CHECK_MODEL=
GOOGLE_QUALITY_CHECK_MODELS=

# Optional alternate media providers.
SEEDANCE_API_KEY=
SEEDANCE_VIDEO_BASE_URL=
BYTEDANCE_API_KEY=
BYTEDANCE_BASE_URL=
BYTEDANCE_IMAGE_BASE_URL=
BYTEDANCE_IMAGE_SIZE=
BYTEDANCE_IMAGE_TIMEOUT_MS=
BYTEDANCE_VIDEO_BASE_URL=
ARK_API_KEY=

# Optional billing and render integrations.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PYTHON_SERVICE_URL=http://localhost:8001
SHOTSTACK_RENDER_SUBMIT_TIMEOUT_MS=
SHOTSTACK_STATUS_TIMEOUT_MS=

# Optional local testing defaults.
NEXT_PUBLIC_STUDIO_PROJECT_ID=
NEXT_PUBLIC_STUDIO_AUDIO_URL=
NEXT_PUBLIC_STUDIO_ACCESS_TOKEN=

# Leave empty for direct browser-to-local-API use. If set, protected studio
# routes expect x-studio-backend-key from a server-side proxy.
STUDIO_BACKEND_SHARED_SECRET=
